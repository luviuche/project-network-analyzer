# Plantilla de variables de entorno.
# 1. Copia este archivo como .env  ->  cp .env.example .env
# 2. Reemplaza el valor con tu clave real del API de Claude.
# 3. NUNCA subas el archivo .env al repositorio (ya está en .gitignore).
#
# Sin clave, el agente funciona igual en modo fallback (solo capa determinista).

ANTHROPIC_API_KEY=tu_clave_api_aqui

# Opcionales. Si no se definen, se usan los valores por defecto de config.py.
#
# Modelo de Claude para la capa LLM. Por defecto: claude-haiku-4-5-20251001
# (rápido y económico). Usa claude-sonnet-5 si prefieres mejor redacción.
# PNA_MODEL=claude-sonnet-5
#
# Tope de tokens de la respuesta del modelo. Por defecto: 4000.
# Un valor que no sea un entero positivo aborta el arranque.
# PNA_MAX_TOKENS=4000
