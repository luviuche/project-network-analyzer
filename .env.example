# Environment variable template.
# 1. Copy this file to .env  ->  cp .env.example .env
# 2. Replace the value with your real Claude API key.
# 3. NEVER commit the .env file (it is already in .gitignore).
#
# Without a key the agent still works, in fallback mode (deterministic
# layer only).

ANTHROPIC_API_KEY=your_api_key_here

# Optional. When unset, the defaults in config.py apply.
#
# Claude model for the LLM layer. Default: claude-haiku-4-5-20251001
# (fast and cheap). Use claude-sonnet-5 for better prose.
# PNA_MODEL=claude-sonnet-5
#
# Cap on the model's response tokens. Default: 4000.
# A value that is not a positive integer aborts startup.
# PNA_MAX_TOKENS=4000
